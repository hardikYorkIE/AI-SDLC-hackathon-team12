# Copy to .env (gitignored) — used for authenticated audits
AUDIT_LOGIN_URL=https://stage.futureonesports.com/login
AUDIT_USER=divy@york.ie
AUDIT_PASSWORD=Divy@12345
# Optional: require URL to contain this after login
# AUDIT_SUCCESS_URL=/dashboard
# Optional: reuse a saved Playwright session instead of logging in
# AUDIT_STORAGE_STATE=artifacts/latest/auth-storage.json
# Optional: path to auth.config.json
# AUDIT_AUTH_CONFIG=./auth.config.json
# Optional: Jira, used by "Create Jira tasks" on the report. Or use jira.config.json.
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=UX
# JIRA_ISSUE_TYPE=Task
